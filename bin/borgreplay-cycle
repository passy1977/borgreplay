#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Copyright (C) 2026 Antonio Salsi
#
# borgreplay-cycle - daily wake / replica / check / suspend cycle
#
# Runs as a runit service. On every wake-up (or boot):
#   1. waits for borg to complete the replica (marker updated) or a timeout
#   2. if due, starts the pool scrub and waits for it to finish
#   3. runs borgreplay-check (full report one day a week)
#   4. waits for the machine to be idle (no logged-in users, no rsync)
#   5. suspends to RAM until the next wake-up
#
# To keep it awake:        touch /etc/borgreplay/stay-awake
# To let it sleep again:   rm /etc/borgreplay/stay-awake
# The file is also created when the marker written by the client contains
# "stay-awake" (bck_sync_to_borgreplay --stay-awake)
#
# Settings can be overridden in /etc/borgreplay/cycle.conf

# ---------------------------------------------------------------- configuration

WAKE_TIME="02:00"                           # local time of the daily wake-up
POOL="backup"                               # ZFS pool
SYNC_MARKER="/backup/borgrepo/.last_sync"   # file touched by borg when the replica ends
SYNC_WAIT_MIN=360                           # maximum wait for the replica (minutes)
SCRUB_EVERY_DAYS=30                         # interval between two scrubs
REPORT_DOW=1                                # day of the full report (1 = Monday)
STAY_AWAKE="/etc/borgreplay/stay-awake"     # if present, no suspend
CHECK="borgreplay-check"                    # looked up in PATH
POLL=60                                     # polling interval (seconds)
SETTLE=30                                   # wait after wake-up (network, tunnel)

[ -r /etc/borgreplay/cycle.conf ] && . /etc/borgreplay/cycle.conf

# ------------------------------------------------------------------------------

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
LC_ALL=C
export LC_ALL

log() {
    logger -t borgreplay-cycle -- "$*"
}

now() {
    date +%s
}

marker_ts() {
    stat -c %Y "$SYNC_MARKER" 2>/dev/null || echo 0
}

# Waits for the marker to be newer than time $1
wait_sync() {
    since="$1"
    deadline=$(( since + SYNC_WAIT_MIN * 60 ))
    while [ "$(now)" -lt "$deadline" ]; do
        [ "$(marker_ts)" -ge "$since" ] && return 0
        sleep "$POLL"
    done
    return 1
}

# If the client asked for it in the marker, creates $STAY_AWAKE with a note
stay_awake_request() {
    grep -qw stay-awake "$SYNC_MARKER" 2>/dev/null || return 0
    [ -e "$STAY_AWAKE" ] && return 0
    {
        echo "Created by borgreplay-cycle on $(date '+%Y-%m-%d %H:%M:%S'):"
        echo "the replica $(cut -d' ' -f1 "$SYNC_MARKER") asked to stay awake."
        echo "Remove this file after the remote login to let the machine suspend."
    } > "$STAY_AWAKE"
    log "stay-awake requested by the replica, $STAY_AWAKE created"
}

pool_busy() {
    zpool status "$POOL" 2>/dev/null | grep -q -E '(scrub|resilver) in progress'
}

scrub_due() {
    pool_busy && return 1
    last="$(zpool status "$POOL" 2>/dev/null | sed -n 's/.*scrub repaired.* on //p')"
    [ -z "$last" ] && return 0
    ts="$(date -d "$last" +%s 2>/dev/null)" || return 1
    [ $(( ($(now) - ts) / 86400 )) -ge "$SCRUB_EVERY_DAYS" ]
}

# Prints why the machine cannot suspend; empty = idle
busy_reason() {
    if [ -e "$STAY_AWAKE" ]; then
        echo "$STAY_AWAKE present"
    elif [ -n "$(who 2>/dev/null)" ]; then
        echo "users logged in"
    elif pgrep -x rsync >/dev/null 2>&1; then
        echo "rsync running"
    elif pool_busy; then
        echo "scrub or resilver in progress"
    fi
}

wait_idle() {
    last_reason=""
    while :; do
        reason="$(busy_reason)"
        [ -z "$reason" ] && return 0
        if [ "$reason" != "$last_reason" ]; then
            log "staying awake: $reason"
            last_reason="$reason"
        fi
        sleep "$POLL"
    done
}

# Waits for postfix to deliver the mail (2 minutes at most)
flush_mail() {
    command -v postqueue >/dev/null 2>&1 || { sleep 30; return; }
    i=0
    while [ "$i" -lt 12 ]; do
        postqueue -p 2>/dev/null | grep -q 'queue is empty' && return 0
        sleep 10
        i=$(( i + 1 ))
    done
    log "mail still queued after 2 minutes"
}

# Seconds until the next wake-up
seconds_to_wake() {
    n="$(now)"
    target="$(date -d "today $WAKE_TIME" +%s)"
    if [ "$target" -le $(( n + 300 )) ]; then
        target="$(date -d "tomorrow $WAKE_TIME" +%s)"
    fi
    echo $(( target - n ))
}

# ------------------------------------------------------------------------- main

if [ "$(id -u)" -ne 0 ]; then
    echo "borgreplay-cycle: must be run as root" >&2
    exit 2
fi

while :; do
    start="$(now)"
    log "awake, waiting for the replica (at most $SYNC_WAIT_MIN minutes)"
    sleep "$SETTLE"

    if wait_sync "$start"; then
        log "replica completed"
        stay_awake_request
    else
        log "no replica within $SYNC_WAIT_MIN minutes"
    fi

    if scrub_due; then
        log "starting scrub of pool $POOL"
        zpool scrub "$POOL"
    fi
    while pool_busy; do
        sleep "$POLL"
    done

    if [ "$(date +%u)" = "$REPORT_DOW" ]; then
        "$CHECK" --report
    else
        "$CHECK"
    fi
    flush_mail

    # Suspends; if the machine got busy again or suspend fails, retries
    while :; do
        wait_idle
        secs="$(seconds_to_wake)"
        log "suspending for $(( secs / 60 )) minutes (wake-up at $WAKE_TIME)"
        sync
        if rtcwake -m mem -s "$secs" >/dev/null 2>&1; then
            break
        fi
        log "suspend failed, retrying in 10 minutes"
        sleep 600
    done
done
