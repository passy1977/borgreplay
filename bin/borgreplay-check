#!/bin/sh
#
# borgreplay-check - borgreplay health checks with mail notification
#
# Usage (as root):
#   borgreplay-check            check; send a mail only if there are problems
#   borgreplay-check --report   always send the full report
#   borgreplay-check --boot     system boot notification (with report)
#   borgreplay-check --stdout   print to screen and send nothing (for testing)
#
# Dependencies: zfs, smartmontools, sendmail (postfix). Optional: wireguard-tools,
# drivetemp and nct6775 modules, apcupsd.

# ---------------------------------------------------------------- configuration

MAILTO="admin@example.com"

POOL="backup"                               # ZFS pool to check
POOL_MAX_PCT=80                             # maximum pool usage %
SCRUB_MAX_DAYS=40                           # maximum days since the last scrub

SYNC_MARKER="/backup/borgrepo/.last_sync"   # file touched by borg when the replica ends
SYNC_MAX_DAYS=2                             # maximum days without a replica

ROOT_MAX_PCT=85                             # maximum root usage %
TEMP_MAX=45                                 # maximum disk temperature (C)

FANS="1 2 3"                                # fanN channels that must be spinning
FAN_MIN_RPM=300                             # below this threshold = fan stopped

WG_MAX_SEC=600                              # maximum age of the WireGuard handshake
                                            # (requires PersistentKeepalive on the peer)

STATE_DIR="/var/lib/borgreplay-check"       # state to avoid repeating the same mail
REPEAT_MIN=1380                             # repeat an unchanged alarm after 23 hours

# ------------------------------------------------------------------------------

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
LC_ALL=C
export LC_ALL

MODE="${1:-check}"
HOST="$(hostname)"
NOW="$(date +%s)"
PROBLEMS=""
NL='
'

warn() {
    PROBLEMS="${PROBLEMS}- $*${NL}"
}

have() {
    command -v "$1" >/dev/null 2>&1
}

# ----------------------------------------------------------------------- checks

check_zfs() {
    if ! have zpool; then
        warn "ZFS: zpool command not found"
        return
    fi

    st="$(zpool status -x "$POOL" 2>&1)"
    case "$st" in
        *"is healthy"*) ;;
        *) warn "ZFS: pool '$POOL' is not healthy (see details)" ;;
    esac

    cap="$(zpool list -H -o capacity "$POOL" 2>/dev/null | tr -d '%')"
    if [ -n "$cap" ] && [ "$cap" -ge "$POOL_MAX_PCT" ]; then
        warn "ZFS: pool '$POOL' is ${cap}% full (threshold ${POOL_MAX_PCT}%)"
    fi

    full="$(zpool status "$POOL" 2>/dev/null)"
    case "$full" in
        *"scrub in progress"*) return ;;
    esac
    last="$(printf '%s\n' "$full" | sed -n 's/.*scrub repaired.* on //p')"
    if [ -z "$last" ]; then
        warn "ZFS: no scrub recorded on pool '$POOL'"
    else
        ts="$(date -d "$last" +%s 2>/dev/null)"
        if [ -n "$ts" ]; then
            days=$(( (NOW - ts) / 86400 ))
            if [ "$days" -gt "$SCRUB_MAX_DAYS" ]; then
                warn "ZFS: last scrub $days days ago (threshold $SCRUB_MAX_DAYS)"
            fi
        fi
    fi
}

check_smart() {
    if ! have smartctl; then
        warn "SMART: smartctl command not found"
        return
    fi

    for dev in /dev/sd?; do
        [ -b "$dev" ] || continue
        # Empty slots (card readers) and removable devices: not disks
        name="${dev#/dev/}"
        [ "$(cat "/sys/block/$name/size" 2>/dev/null)" = "0" ] && continue
        [ "$(cat "/sys/block/$name/removable" 2>/dev/null)" = "1" ] && continue
        # -n standby: does not wake up a disk in standby
        out="$(smartctl -n standby -i -H -A "$dev" 2>&1)"
        case "$out" in
            *"STANDBY"*|*"SLEEP"*) continue ;;
        esac
        # Devices without SMART (USB sticks, USB adapters): nothing to check
        case "$out" in
            *"SMART support is: Enabled"*) ;;
            *) continue ;;
        esac

        serial="$(printf '%s\n' "$out" | awk -F': *' '/^Serial Number/ {print $2}')"
        id="$dev (${serial:-unknown serial})"

        if ! printf '%s\n' "$out" | grep -q 'PASSED'; then
            warn "SMART: $id fails the health test"
        fi

        bad="$(printf '%s\n' "$out" | awk '
            $1 == 5 || $1 == 197 || $1 == 198 {
                if ($10 + 0 > 0) printf "%s=%s ", $2, $10
            }')"
        if [ -n "$bad" ]; then
            warn "SMART: $id has problematic sectors: $bad"
        fi
    done
}

# Prints "device model serial temperature" for each disk seen by drivetemp
disk_temps() {
    for h in /sys/class/hwmon/hwmon*; do
        [ "$(cat "$h/name" 2>/dev/null)" = "drivetemp" ] || continue
        d="$(ls "$h/device/block" 2>/dev/null | head -1)"
        [ -n "$d" ] || continue
        t=$(( $(cat "$h/temp1_input") / 1000 ))
        printf '%s|%s|%s|%s\n' "$d" \
            "$(cat "$h/device/model" 2>/dev/null | sed 's/ *$//')" \
            "$(lsblk -dno SERIAL "/dev/$d" 2>/dev/null)" \
            "$t"
    done
}

check_temps() {
    temps="$(disk_temps)"
    if [ -z "$temps" ]; then
        warn "Temperatures: no drivetemp sensor (module not loaded?)"
        return
    fi
    old_ifs="$IFS"
    IFS='|'
    printf '%s\n' "$temps" | while read -r d model serial t; do
        if [ "$t" -ge "$TEMP_MAX" ]; then
            echo "Temperatures: $d ($serial) at ${t}C (threshold ${TEMP_MAX}C)"
        fi
    done > "$TMP/temps"
    IFS="$old_ifs"
    while read -r line; do
        [ -n "$line" ] && warn "$line"
    done < "$TMP/temps"
}

check_sync() {
    if [ ! -e "$SYNC_MARKER" ]; then
        warn "Replica: marker $SYNC_MARKER missing (no replica completed?)"
        return
    fi
    limit=$(( SYNC_MAX_DAYS * 1440 ))
    if [ -n "$(find "$SYNC_MARKER" -mmin +"$limit" 2>/dev/null)" ]; then
        ts="$(stat -c %Y "$SYNC_MARKER")"
        days=$(( (NOW - ts) / 86400 ))
        warn "Replica: no Borg replica for $days days (threshold $SYNC_MAX_DAYS)"
    fi
}

check_root() {
    pct="$(df -P / | awk 'NR == 2 { gsub("%", "", $5); print $5 }')"
    if [ -n "$pct" ] && [ "$pct" -ge "$ROOT_MAX_PCT" ]; then
        warn "System disk: root is ${pct}% full (threshold ${ROOT_MAX_PCT}%)"
    fi
}

check_wg() {
    have wg || return
    hs="$(wg show all latest-handshakes 2>/dev/null)"
    if [ -z "$hs" ]; then
        warn "WireGuard: no active interface"
        return
    fi
    printf '%s\n' "$hs" | while read -r iface peer ts; do
        if [ "$ts" = "0" ]; then
            echo "WireGuard: $iface, no handshake with the peer"
        else
            age=$(( NOW - ts ))
            if [ "$age" -gt "$WG_MAX_SEC" ]; then
                echo "WireGuard: $iface, last handshake $(( age / 60 )) minutes ago"
            fi
        fi
    done > "$TMP/wg"
    while read -r line; do
        [ -n "$line" ] && warn "$line"
    done < "$TMP/wg"
}

nct_dir() {
    for h in /sys/class/hwmon/hwmon*; do
        case "$(cat "$h/name" 2>/dev/null)" in
            nct67*) echo "$h"; return ;;
        esac
    done
}

check_fans() {
    dir="$(nct_dir)"
    if [ -z "$dir" ]; then
        warn "Fans: nct67xx chip not available (nct6775 module not loaded?)"
        return
    fi
    for n in $FANS; do
        rpm="$(cat "$dir/fan${n}_input" 2>/dev/null)"
        if [ -z "$rpm" ] || [ "$rpm" -lt "$FAN_MIN_RPM" ]; then
            warn "Fans: fan$n at ${rpm:-?} RPM (stopped or disconnected)"
        fi
    done
}

check_services() {
    have sv || return
    for s in /var/service/*; do
        if [ -L "$s" ] && [ ! -e "$s" ]; then
            warn "Services: $(basename "$s") is a broken link in /var/service"
            continue
        fi
        [ -d "$s" ] || continue
        st="$(sv status "$s" 2>&1)"
        case "$st" in
            run:*) ;;
            *) warn "Services: $(basename "$s") not running ($st)" ;;
        esac
    done
}

check_ups() {
    have apcaccess || return
    st="$(apcaccess -p STATUS 2>/dev/null | sed 's/ *$//')"
    case "$st" in
        ONLINE*) ;;
        "") warn "UPS: apcupsd not responding" ;;
        *) warn "UPS: status '$st'" ;;
    esac
}

# ----------------------------------------------------------------------- report

details() {
    echo "== System =="
    echo "Host:    $HOST"
    echo "Date:    $(date '+%Y-%m-%d %H:%M:%S %Z')"
    echo "Uptime: $(uptime)"
    echo "Kernel:  $(uname -r)"
    echo

    echo "== Last Borg replica =="
    if [ -e "$SYNC_MARKER" ]; then
        date -r "$SYNC_MARKER" '+%Y-%m-%d %H:%M:%S'
    else
        echo "marker missing ($SYNC_MARKER)"
    fi
    echo

    echo "== ZFS =="
    zpool list "$POOL" 2>&1
    echo
    zpool status "$POOL" 2>&1
    echo

    echo "== Disks =="
    disk_temps | awk -F'|' '{ printf "%-5s %-24s %-18s %s C\n", $1, $2, $3, $4 }'
    echo

    echo "== Space =="
    df -h / 2>&1
    echo

    echo "== Fans and motherboard =="
    dir="$(nct_dir)"
    if [ -n "$dir" ]; then
        for n in $FANS; do
            echo "fan$n: $(cat "$dir/fan${n}_input" 2>/dev/null) RPM"
        done
    else
        echo "nct67xx chip not available"
    fi
    echo

    if have wg; then
        echo "== WireGuard =="
        wg show all latest-handshakes 2>/dev/null | while read -r iface peer ts; do
            if [ "$ts" = "0" ]; then
                echo "$iface: no handshake"
            else
                echo "$iface: last handshake $(( (NOW - ts) / 60 )) minutes ago"
            fi
        done
        echo
    fi

    if have apcaccess; then
        echo "== UPS =="
        apcaccess 2>&1 | grep -E '^(STATUS|LINEV|LOADPCT|BCHARGE|TIMELEFT|BATTDATE)'
        echo
    fi

    if have sv; then
        echo "== Services =="
        for s in /var/service/*; do
            [ -d "$s" ] && sv status "$s" 2>&1
        done
    fi
}

body() {
    if [ -n "$PROBLEMS" ]; then
        echo "PROBLEMS DETECTED:"
        printf '%s' "$PROBLEMS"
    else
        echo "No problems detected."
    fi
    echo
    details
}

send_mail() {
    subject="$1"
    {
        printf 'To: %s\n' "$MAILTO"
        printf 'Subject: %s\n' "$subject"
        printf 'Content-Type: text/plain; charset=UTF-8\n'
        printf '\n'
        cat
    } | sendmail -t
}

# ------------------------------------------------------------------------- main

if [ "$(id -u)" -ne 0 ]; then
    echo "borgreplay-check: must be run as root" >&2
    exit 2
fi

TMP="$(mktemp -d)" || exit 2
trap 'rm -rf "$TMP"' EXIT

check_zfs
check_smart
check_temps
check_sync
check_root
check_wg
check_fans
check_services
check_ups

case "$MODE" in
    --stdout)
        body
        ;;

    --report)
        if [ -n "$PROBLEMS" ]; then
            body | send_mail "[$HOST] Report: PROBLEMS"
        else
            body | send_mail "[$HOST] Report: all OK"
        fi
        ;;

    --boot)
        {
            echo "The system has booted."
            echo
            body
        } | send_mail "[$HOST] System booted"
        ;;

    check)
        mkdir -p "$STATE_DIR"
        if [ -n "$PROBLEMS" ]; then
            printf '%s' "$PROBLEMS" > "$STATE_DIR/current"
            # Same alarm already sent recently: do not repeat
            if cmp -s "$STATE_DIR/current" "$STATE_DIR/last" &&
               [ -n "$(find "$STATE_DIR/last" -mmin -"$REPEAT_MIN" 2>/dev/null)" ]; then
                rm -f "$STATE_DIR/current"
                exit 1
            fi
            mv "$STATE_DIR/current" "$STATE_DIR/last"
            body | send_mail "[$HOST] ALARM: problems detected"
        elif [ -e "$STATE_DIR/last" ]; then
            rm -f "$STATE_DIR/last"
            body | send_mail "[$HOST] Resolved: all OK"
        fi
        ;;

    *)
        echo "Usage: borgreplay-check [--report|--boot|--stdout]" >&2
        exit 2
        ;;
esac

[ -z "$PROBLEMS" ]
