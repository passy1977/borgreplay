# /etc/cron.d/borgreplay-check
# Version for the "scheduled suspend" mode: periodic checks, weekly report and
# scrub are handled by borgreplay-cycle, because cron does not run while the
# machine is suspended. Only the cold boot notification is left here.

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""

# Boot notification (after a power outage or a reboot): waits for network, postfix and WireGuard
@reboot       root  sleep 120; /usr/local/bin/borgreplay-check --boot
