# INSTALL - xbps install script of borgreplay
#
# Arguments: $1 action (pre/post), $2 pkgname, $3 version, $4 update (yes/no)
#
# post: moves the files of the versions before /etc/borgreplay/ into it. The
# moved settings replace the commented templates installed by the package.

case "$1" in
post)
    for pair in borgreplay.env:borgreplay.env borgreplay-cycle.conf:cycle.conf \
                borgreplay-stay-awake:stay-awake; do
        old="etc/${pair%%:*}"
        new="etc/borgreplay/${pair#*:}"
        if [ -e "$old" ]; then
            mv -f "$old" "$new"
            echo "borgreplay: moved /$old to /$new"
        fi
    done
    rm -f etc/borgreplay.env.new-* etc/borgreplay-cycle.conf.new-*
    ;;
esac
