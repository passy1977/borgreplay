# borgreplay - site settings
#
# Copy to .env and fill in. install.sh and install-client.sh install it as
# /etc/borgreplay.env on both machines; the scripts source it as shell code.

# Recipient of the borgreplay-check mail
MAILTO="admin@example.com"

# Address of the replica server (borgreplay), as reached from the Borg host
REPLICA_HOST="192.0.2.10"

# User owning /backup/borgrepo on the replica server
REPLICA_USER="backup"

# SSH key used by root on the Borg host (absolute path)
#SSH_KEY="/root/.ssh/id_ed25519_borgreplay"

# Borg host, used by install-client.sh to install the client side
CLIENT_HOST="192.0.2.20"
CLIENT_USER="admin"
